using Gtk 4.0;
using Adw 1;

template $FilterRuleDialog: Adw.Dialog {
    title: _("Add Filter Rule");
    content-width: 400;
    content-height: 300;

    Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            show-end-title-buttons: false;

            [start]
            Gtk.Button cancel_btn {
                label: _("Cancel");
                action-name: "window.close";
            }

            [end]
            Gtk.Button add_btn {
                label: _("Add");

                css-classes: [
                    "suggested-action",
                ];
            }
        }

        content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
                title: _("Rule Details");

                Adw.EntryRow name_entry {
                    title: _("Name");
                }

                Adw.EntryRow regex_entry {
                    title: _("Regex Pattern");
                }

                Adw.ComboRow action_combo {
                    title: _("Action");

                    model: Gtk.StringList {
                        strings [
                            _("Mute"),
                            _("Discard"),
                            _("Mark Read"),
                        ]
                    };
                }
            }
        };
    }
}
