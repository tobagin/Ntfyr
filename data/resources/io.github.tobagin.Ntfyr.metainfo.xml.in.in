<?xml version="1.0" encoding="UTF-8"?>
<!-- ranfdev 2019 <ranfdev@gmail.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <!-- Insert your license of choice here -->
  <project_license>GPL-3.0-or-later</project_license>
  <name>Ntfyr</name>
  <summary>Receive and send ntfy notifications</summary>
  <description>
    <p>Ntfyr is a native client for ntfy.sh designed for the GNOME Desktop. It allows you to receive notifications from the ntfy.sh service or your own self-hosted ntfy server directly on your desktop.</p>
    <ul>
      <li>Receive and send notifications via ntfy.sh or self-hosted servers</li>
      <li>Run in the background to never miss a notification</li>
      <li>View past notifications with local history support</li>
      <li>Support for attachments and action buttons</li>
      <li>Manage subscriptions grouped by server</li>
    </ul>
    <p>ntfy is a simple HTTP-based pub-sub notification service. It allows you to send notifications to your phone or desktop via scripts from any computer, entirely without signup, cost or 3rd party apps.</p>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#89c69d</color>
    <color type="primary" scheme_preference="dark">#2f483e</color>
  </branding>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword translate="no">GTK</keyword>
    <keyword translate="no">GNOME</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/tobagin/Ntfyr/main/data/screenshots/main-window.png</image>
      <caption>Main window</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/tobagin/Ntfyr/main/data/screenshots/topics.png</image>
      <caption>Topics view</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/tobagin/Ntfyr/main/data/screenshots/preferences.png</image>
      <caption>Preferences</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/tobagin/Ntfyr</url>
  <url type="bugtracker">https://github.com/tobagin/Ntfyr/issues</url>
  <url type="donation">https://github.com/sponsors/tobagin</url>
  <url type="help">https://github.com/tobagin/Ntfyr/discussions</url>
  <url type="vcs-browser">https://github.com/tobagin/Ntfyr</url>

  <content_rating type="oars-1.0" />
  <releases>
    <release version="0.6.2" date="2026-06-14">
      <description>
        <p>Security release.</p>
        <ul>
          <li>Escape markdown link URLs to prevent markup injection from notification content.</li>
          <li>Restrict notification action URLs to http(s) and confirm HTTP actions before sending.</li>
          <li>Constant-time app-lock password checks that fail closed on keyring errors.</li>
          <li>Harden the daemon against malformed or malicious server data.</li>
        </ul>
      </description>
    </release>
    <release version="0.6.1" date="2026-06-03">
      <description>
        <p>Maintenance release.</p>
        <ul>
          <li>Updated all Rust dependencies to their latest compatible versions.</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-06-03">
      <description>
        <p>Feature release.</p>
        <ul>
          <li>Added a UI language selector in Preferences to choose the interface language independently of the system locale.</li>
          <li>Added European Portuguese, Brazilian Portuguese, and British English translations, alongside Russian, German, Spanish, and French.</li>
          <li>New subscriptions now load the server's topic history on first connect without replaying it as desktop notifications.</li>
          <li>The window is now always presented when launching the app while a background instance is running.</li>
        </ul>
      </description>
    </release>
    <release version="0.5.4" date="2026-05-10">
      <description>
        <p>Bug fix release.</p>
        <ul>
          <li>Fixed crash on startup when xdg-desktop-portal Secret backend is missing or returns an unusable master key; the keyring now falls back to the host Secret Service.</li>
          <li>Fixed "Add account" failing with "Password (secret from portal) too short: 0" by retrying via Secret Service when the portal returns an unusable secret.</li>
          <li>Tray icon now uses theme-aware symbolic SVGs so it stays visible on KDE Breeze Dark and other dark panels.</li>
          <li>Clearing notifications no longer replays the server-side topic cache after a restart.</li>
          <li>Desktop portal notifications use a stable per-(server, topic) id, preventing inflated launcher badge counts.</li>
        </ul>
      </description>
    </release>
    <release version="0.5.3" date="2026-03-28">
      <description>
        <p>Bug fix release.</p>
        <ul>
          <li>Fixed HTTPS connections to private/self-hosted ntfy servers failing with "invalid URL, scheme is not http"</li>
        </ul>
      </description>
    </release>
    <release version="0.5.2" date="2026-03-23">
      <description>
        <p>Build cleanup release.</p>
        <ul>
          <li>Removed unused capnproto build dependency from Flatpak manifests</li>
        </ul>
      </description>
    </release>
    <release version="0.5.1" date="2026-03-23">
      <description>
        <p>Build fix release.</p>
        <ul>
          <li>Fixed Flatpak build by correcting Cargo.lock and cargo-sources.json</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-03-23">
      <description>
        <p>✨ New features, bug fixes, and updated dependencies.</p>
        <ul>
          <li>New customizable date/time format preference for message timestamps</li>
          <li>Fixed: app now brings window to foreground on re-activation</li>
          <li>Fixed: tray icon is now visible on KDE dark themes</li>
          <li>Updated Flatpak runtime to GNOME 50</li>
          <li>Updated all Rust dependencies to latest versions</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-02-15">
      <description>
        <p>Fixed AppStream metadata validation issues.</p>
        <ul>
          <li>Fixed metadata validation issues by removing HTML tags from release description</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-02-15">
      <description>
        <p>App Locking and improved Privacy features.</p>
        <ul>
          <li>App Lock with PIN code to secure your messages</li>
          <li>Auto-lock functionality</li>
          <li>Privacy settings to hide notification content when locked</li>
          <li>Secrets are now stored securely using libsecret</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-01-25">
      <description>
        <p>End-to-End Encryption support for secure messaging.</p>
        <ul>
          <li>Added End-to-End Encryption for sending and receiving messages</li>
          <li>New Encrypt Message toggle in Advanced Message Dialog</li>
          <li>Encryption keys stored securely in system keyring</li>
          <li>New Encryption Key field in Subscription Info dialog</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-01-12">
      <description>
        <p>Metadata improvements and documentation updates.</p>
        <ul>
          <li>Improved metadata validation (summary, description, branding coverage)</li>
          <li>Simplified README and added Flathub/Ko-Fi badges</li>
          <li>Improved build instructions</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-01-10">
      <description>
        <p>UI refinements and new filtering capabilities.</p>
        <ul>
          <li>New Filter Rules dialog and functionality</li>
          <li>Unified aesthetics for Add Server/Account dialogs</li>
          <li>Improved Server Actions menu styling</li>
          <li>Correctly display muted icon for muted subscriptions</li>
          <li>Database migration reliability improvements</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-01-06">
      <description>
        <p>Improved sandboxing and security with portal-based notifications.</p>
        <ul>
          <li>Refactored notification system to use XDG Desktop Portal instead of direct D-Bus access</li>
          <li>Better sandboxing following Flatpak best practices</li>
          <li>No longer requires org.freedesktop.Notifications D-Bus permission</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-01-04">
      <description>
        <p>Initial release of Ntfyr, a native client for ntfy.sh.</p>
        <ul>
          <li>Subscriptions grouped by server for better organization</li>
          <li>Unified server preferences with easy default server selection</li>
          <li>Enhanced About dialog with credits and support links</li>
          <li>Receive and send notifications via ntfy.sh or self-hosted servers</li>
          <li>Support for custom servers and basic authentication</li>
          <li>Markdown rendering for messages</li>
          <li>Automatic background execution and autostart</li>
          <li>View past notifications with local caching</li>
          <li>Timezone conversion for timestamps</li>
          <li>Message sorting by date</li>
          <li>Support for attachments and action buttons</li>
          <li>Advanced message dialog for sending complex notifications</li>
          <li>System tray integration</li>
        </ul>
      </description>
    </release>
  </releases>
  <developer_name>Thiago Fernandes</developer_name>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
